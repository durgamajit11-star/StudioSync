# Core Django
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (PostgreSQL example)
# Required on Vercel. Do not use SQLite for deployed login/session storage.
DATABASE_URL=postgresql://username:password@host:5432/dbname
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=True

# Security
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Static files
ENABLE_WHITENOISE=True

# Uploaded media storage
# Recommended on Vercel because local /media uploads are not persistent.
# Get this from Cloudinary Dashboard > API Keys.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
USE_CLOUDINARY_MEDIA=True

# Payments
# Use "demo" for local/manual UPI testing or "razorpay" for live gateway checkout.
PAYMENT_GATEWAY_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10.00

# App server performance (for load-balanced production)
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1200
GUNICORN_MAX_REQUESTS_JITTER=120

# Logging
DJANGO_LOG_LEVEL=INFO
